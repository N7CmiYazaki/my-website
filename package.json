{
  "name": "my-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run css:build && wrangler dev",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
    "css:build": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run css:build && wrangler deploy --dry-run",
    "deploy": "npm run check && npm run css:build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "wrangler": "^4.40.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
